# FinPilot AI — environment template.
#
# PLACEHOLDERS ONLY. Never commit real secrets. Copy this file to `.env`
# (which is git-ignored) for local development and replace placeholders.
#
# Backend settings are read by the `FINPILOT_` prefixed settings loader.
# Values below are safe local-development defaults and are NOT production-safe.

# --- Runtime ---------------------------------------------------------------
FINPILOT_APP_ENV=development
FINPILOT_DEBUG=true
FINPILOT_HOST=127.0.0.1
FINPILOT_PORT=8000
FINPILOT_LOG_LEVEL=INFO
FINPILOT_DOCS_ENABLED=true

# --- Secret (REQUIRED in production; development does not use it) ----------
# Generate with a cryptographically secure random source, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FINPILOT_SECRET_KEY=replace-with-a-long-random-value-not-a-real-secret

# --- Database (localhost file for dev; production must be a TLS database) --
FINPILOT_DATABASE_URL=sqlite:///./finpilot_dev.db

# --- CORS (explicit origins only; never "*") -------------------------------
FINPILOT_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Frontend (Vite) -------------------------------------------------------
# NON-SECRET values only. NEVER put API keys, tokens or passwords in VITE_*.
VITE_API_BASE_URL=http://127.0.0.1:8000
